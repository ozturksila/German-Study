# Copy this to .env and fill in ONE of the keys below — or use no key at all:
# the writing page also offers a copy-and-paste route (works with Gemini Pro,
# ChatGPT or Claude in the browser) and a local Ollama model.
#
#   cp .env.example .env
#
# server.py also reads ../backend/.env, so a key already there is picked up.

ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OPENAI_API_KEY=

# Optional overrides
# AI_PROVIDER=gemini          # anthropic | gemini | openai — otherwise the first key found wins
# AI_MODEL=gemini-2.5-flash
# OPENAI_BASE_URL=http://localhost:1234/v1   # LM Studio, vLLM, any OpenAI-compatible server
